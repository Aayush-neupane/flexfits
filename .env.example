# FlexFits Environment Variables
# Copy this file to .env and fill in your values

# App
VITE_APP_NAME=FlexFits
VITE_APP_URL=http://localhost:3000

# Analytics (optional)
VITE_GA_ID=
VITE_PLAUSIBLE_DOMAIN=

# API (if needed)
VITE_API_URL=

# Lead inbox — address that receives Contact + Free-class forms.
# 1. Set it to an inbox you own. 2. Submit once to trigger FormSubmit's
# activation email and click it. Until then forms fail closed with a call CTA.
VITE_LEAD_EMAIL=

# External Services (optional)
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_SENDGRID_API_KEY=